ninja_required_version = 1.3
cxx = c++
nvcc = /usr/local/cuda/bin/nvcc

cflags = -DTORCH_EXTENSION_NAME=MultiScaleDeformableAttention -DTORCH_API_INCLUDE_EXTENSION_H -DPYBIND11_COMPILER_TYPE=\"_gcc\" -DPYBIND11_STDLIB=\"_libstdcpp\" -DPYBIND11_BUILD_ABI=\"_cxxabi1011\" -isystem /home/ubuntu/slocal2/m2/.venv-relation-detr/lib/python3.11/site-packages/torch/include -isystem /home/ubuntu/slocal2/m2/.venv-relation-detr/lib/python3.11/site-packages/torch/include/torch/csrc/api/include -isystem /home/ubuntu/slocal2/m2/.venv-relation-detr/lib/python3.11/site-packages/torch/include/TH -isystem /home/ubuntu/slocal2/m2/.venv-relation-detr/lib/python3.11/site-packages/torch/include/THC -isystem /usr/local/cuda/include -isystem /home/ubuntu/.local/share/uv/python/cpython-3.11.16-linux-x86_64-gnu/include/python3.11 -D_GLIBCXX_USE_CXX11_ABI=0 -fPIC -std=c++17 -O2
post_cflags = 
cuda_cflags = -DTORCH_EXTENSION_NAME=MultiScaleDeformableAttention -DTORCH_API_INCLUDE_EXTENSION_H -DPYBIND11_COMPILER_TYPE=\"_gcc\" -DPYBIND11_STDLIB=\"_libstdcpp\" -DPYBIND11_BUILD_ABI=\"_cxxabi1011\" -isystem /home/ubuntu/slocal2/m2/.venv-relation-detr/lib/python3.11/site-packages/torch/include -isystem /home/ubuntu/slocal2/m2/.venv-relation-detr/lib/python3.11/site-packages/torch/include/torch/csrc/api/include -isystem /home/ubuntu/slocal2/m2/.venv-relation-detr/lib/python3.11/site-packages/torch/include/TH -isystem /home/ubuntu/slocal2/m2/.venv-relation-detr/lib/python3.11/site-packages/torch/include/THC -isystem /usr/local/cuda/include -isystem /home/ubuntu/.local/share/uv/python/cpython-3.11.16-linux-x86_64-gnu/include/python3.11 -D_GLIBCXX_USE_CXX11_ABI=0 -D__CUDA_NO_HALF_OPERATORS__ -D__CUDA_NO_HALF_CONVERSIONS__ -D__CUDA_NO_BFLOAT16_CONVERSIONS__ -D__CUDA_NO_HALF2_OPERATORS__ --expt-relaxed-constexpr -gencode=arch=compute_86,code=compute_86 -gencode=arch=compute_86,code=sm_86 --compiler-options '-fPIC' -std=c++17
cuda_post_cflags = 
cuda_dlink_post_cflags = 
ldflags = -shared -L/home/ubuntu/slocal2/m2/.venv-relation-detr/lib/python3.11/site-packages/torch/lib -lc10 -lc10_cuda -ltorch_cpu -ltorch_cuda -ltorch -ltorch_python -L/usr/local/cuda/lib64 -lcudart

rule compile
  command = $cxx -MMD -MF $out.d $cflags -c $in -o $out $post_cflags
  depfile = $out.d
  deps = gcc

rule cuda_compile
  depfile = $out.d
  deps = gcc
  command = $nvcc  $cuda_cflags -c $in -o $out $cuda_post_cflags



rule link
  command = $cxx $in $ldflags -o $out

build ms_deform_attn_cuda.cuda.o: cuda_compile /home/ubuntu/slocal2/m2/third_party/Relation-DETR/models/bricks/ops/cuda/ms_deform_attn_cuda.cu



build MultiScaleDeformableAttention.so: link ms_deform_attn_cuda.cuda.o

default MultiScaleDeformableAttention.so
